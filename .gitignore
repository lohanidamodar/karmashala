**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Inno Setup installer output
windows/installer/output/
.env.android
.env.android.codemagic
.env.ios
.env.ios.codemagic
android/key.properties
android/app/**/*.jks
android/app/**/*.keystore
android/vendor/bundle
android/.bundle/
ios/vendor/bundle
ios/.bundle/
android/fastlane/report.xml
android/fastlane/README.md
ios/fastlane/report.xml
ios/fastlane/README.md

# Loop 27 device-pane decode spike (throwaway, never shipped)
.spike/
packages/local_ipc/pubspec.lock
# Only the fetched WebDriverAgent blob is ignored, not the whole directory:
# `copy_wda.sh` is run unconditionally by the Runner's build phase, so
# ignoring `macos/Vendor/` wholesale made every fresh clone fail the macOS
# build with `No such file or directory`.
macos/Vendor/wda/
.claude/worktrees/
# Android NDK build output for the vendored flutter_pty; the package is
# in-tree but its native build products are not.
packages/flutter_pty/android/.cxx/

# Gate logs. `tool/gate.ps1` redirects every run here so a verdict is read from
# a file rather than laundered through a pipe; the logs themselves are a
# reading of one machine at one moment and are not history.
.gate/
