# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/app/build/
# `flutter test` inside a workspace member writes its tester assets here.
packages/*/build/
/coverage/
/app/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/app/android/app/debug
/app/android/app/profile
/app/android/app/release

# Inno Setup installer output
app/windows/installer/output/
.env.android
.env.android.codemagic
.env.ios
.env.ios.codemagic
app/android/key.properties
app/android/app/**/*.jks
app/android/app/**/*.keystore
app/android/vendor/bundle
app/android/.bundle/
app/ios/vendor/bundle
app/ios/.bundle/
app/android/fastlane/report.xml
app/android/fastlane/README.md
app/ios/fastlane/report.xml
app/ios/fastlane/README.md

# Loop 27 device-pane decode spike (throwaway, never shipped)
.spike/
packages/local_ipc/pubspec.lock
# The relay's contract resolves on its own for its tests; the relay's lock,
# beside it, is the one that pins what ships.
relay/protocol/pubspec.lock
# Only the fetched WebDriverAgent blob is ignored, not the whole directory:
# `copy_wda.sh` is run unconditionally by the Runner's build phase, so
# ignoring `macos/Vendor/` wholesale made every fresh clone fail the macOS
# build with `No such file or directory`.
app/macos/Vendor/wda/
.claude/worktrees/
# Android NDK build output for the vendored flutter_pty; the package is
# in-tree but its native build products are not.
packages/flutter_pty/android/.cxx/

# Gate logs. `tool/gate.ps1` redirects every run here so a verdict is read from
# a file rather than laundered through a pipe; the logs themselves are a
# reading of one machine at one moment and are not history.
.gate/
